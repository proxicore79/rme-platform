# =============================================================
# Royal Mail Express International — environment
# Copy to `.env` and fill in. Everything is optional except PORT.
# =============================================================

# --- Web server ---
PORT=4000

# --- Supabase (live database). To run against a real project:
#   1) create the tables: Supabase Dashboard -> SQL Editor -> paste supabase/schema.sql -> Run
#   2) set RM_USE_SUPABASE=true and the URL + service role key below
# Without these the app runs on the built-in demo database instead.
RM_USE_SUPABASE=false
SUPABASE_URL=https://xvvknywbgihxewtxazkk.supabase.co
# Server-only secret. NEVER expose this key to the browser / front-end code.
# (The service role key for hxfhayyznpvxdrwaftse is already stored in the
# private .env file in this workspace.)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Admin console key (header X-Admin-Key or ?key=) ---
ADMIN_KEY=rme-admin-2024

# --- Demo database ---
RM_DEMO_DATA_FILE=./data/demo-db.json
RM_AUTO_SEED=true

# --- Email notifications (either SendGrid OR SMTP; leave both empty to log/simulate) ---
SENDGRID_API_KEY=
SENDGRID_FROM=notify@royalmail-express.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=notify@royalmail-express.com

# --- SMS notifications (Twilio; leave empty to log/simulate) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
